From 146334ff1e8ccde4fcf1958a60ad78c58c840513 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Julian=20R=C3=BCth?= <julian.rueth@fsfe.org>
Date: Fri, 6 Nov 2026 13:54:21 -0600
Subject: [PATCH 1/4] Allow SageMath to start when neither HOME nor DOT_SAGE
 are set

---
 src/sage/env.py | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/src/sage/env.py b/src/sage/env.py
index 8e6c6d967e3..26efe2da2e3 100644
--- a/src/sage/env.py
+++ b/src/sage/env.py
@@ -175,7 +175,28 @@ SAGE_DOC_SERVER_URL = var("SAGE_DOC_SERVER_URL")
 SAGE_DOC_LOCAL_PORT = var("SAGE_DOC_LOCAL_PORT", "0")
 
 # ~/.sage
-DOT_SAGE = var("DOT_SAGE", os.path.expanduser("~/.sage"))
+def _create_tmp_dotsage() -> str:
+    r"""
+    Create a temporary directory to be used as ~/.sage on systems where no HOME
+    or DOT_SAGE variables have been set, e.g., in minimal container setups or
+    in rattler-build.
+
+    EXAMPLES::
+
+        sage: from sage.misc.env import _create_tmp_dotsage
+        sage: name = _create_tmp_dotsage()
+
+        sage: import os.path
+        sage: os.path.isdir(name)
+        True
+
+    """
+    from tempfile import TemporaryDirectory
+    tmpdir = TemporaryDirectory(ignore_cleanup_errors=True)
+
+    return tmpdir.name
+
+DOT_SAGE = var("DOT_SAGE", os.path.expanduser("~/.sage")) or _create_tmp_dotsage()
 SAGE_STARTUP_FILE = var("SAGE_STARTUP_FILE", join(DOT_SAGE, "init.sage"))
 
 # for sage_setup.setenv
