Subject: [PATCH 5/5] Do not break long lines when reporting GAP roots

---
 src/sage/ext_data/gap/kernel-info.g | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/sage/ext_data/gap/kernel-info.g b/src/sage/ext_data/gap/kernel-info.g
index aaa0d8ede01..155a2b7d1dd 100644
--- a/src/sage/ext_data/gap/kernel-info.g
+++ b/src/sage/ext_data/gap/kernel-info.g
@@ -8,6 +8,7 @@
 #   riscv
 #   /home/mjo/.gap/;/usr/lib/gap/;/usr/share/gap/
 #
+SizeScreen([65536]);
 KernelInfo := KERNEL_INFO();
 PRINT_TO( "*stdout*", KernelInfo.KERNEL_VERSION, "\n");
 PRINT_TO( "*stdout*", KernelInfo.GAP_ARCHITECTURE, "\n");
